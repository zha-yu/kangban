# ============================================================
# 康伴（SilverMate）· 仓库忽略规则
# 原则：密钥与环境文件永不入库；产物、缓存、大文件不入库；
#      uv.lock / eval/reports / 迁移脚本必须入库。
#      注意区分：eval/reports = 基线/bad case **报告**（入库）；
#      eval/artifacts = 逐条原始 dump、本机时点延迟等**中间产物**（不入库，脚本可复跑）。
# ============================================================

# ---------- 0. 评测中间产物（可复跑，不入库）----------
eval/artifacts/

# ---------- 1. 密钥与环境变量（红线）----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
certs/

# ---------- 2. Python / uv ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.venv_sidecar/
.venv.bak/
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
# uv.lock 是应用项目的锁文件，必须入库，故不忽略

# ---------- 3. 测试 / 静态检查缓存 ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml
report.html

# ---------- 4. Node / 前端（单 React 工程，Vite MPA 三入口）----------
node_modules/
frontend/**/dist/
frontend/**/.vite/
.pnpm-store/
.yarn/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---------- 5. 运行时数据 / 上传 / 日志 ----------
data/
runtime/
uploads/
logs/
*.log
*.pid
*.db
*.sqlite3
pgdata/
redisdata/
langfuse-data/

# ---------- 6. 媒体与 3D 大文件（走 nginx 静态目录或 Git LFS，不进普通提交）----------
assets/media/
static/media/
static/mock/
*.vrm
*.vrma
*.glb
*.fbx
*.blend

# KWS（唤醒词）资产：onnx 模型与 wasm 编译产物体积大（~17MB），不进 Git。
# 重建方法：scripts/build-kws-wasm.md（emsdk 4.0.23 + sherpa-onnx build-wasm-simd-kws.sh，
# 模型 sherpa-onnx-kws-zipformer-wenetspeech-3.3M-2024-01-01-mobile，产物拷入 frontend/public/kws/）
frontend/public/kws/
frontend/src/pad/assets/kws/*.onnx

# ---------- 7. IDE / 编辑器 ----------
.idea/
.vscode/
.trae/
!.vscode/extensions.json
!.vscode/settings.json.example
*.iml
*.swp
*.swo

# ---------- 8. 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 9. 临时目录（spike 实验产物保留代码，丢弃输出）----------
tmp/
scratch/
spikes/**/out/
spikes/**/output/
# 声纹互测原始录音（AGENTS 禁区 10/11：不入库，可随时删除）
spikes/voiceprint/samples/

# ---------- 10. 补丁残留 ----------
*.orig
*.rej
*.bak

# ---------- 11. AI / 笔记工具本地配置目录（不入库）----------
.workbuddy/
.obsidian/

# ---------- 12. pytest / 临时探针目录 ----------
# 本机 TEMP 是 8.3 短名（ADMINI~1），tempfile.gettempdir() 会回退到 CWD，
# pytest 的 tmp_path 工厂因此把 pytest-of-<user>/ 落在仓库根；探针脚本同理。
pytest-of-*/
tts-spike-*/
.probe/
seeds/

# ---------- 13. 本机测试数据唯一台账（账号 / 人员 / 床位 / 设备；含明文口令，不入库）----------
# 约定：以后新建任何测试数据一律登记到本文件，各成员自维护
docs/测试数据_人员与床位.md

# ---------- 14. 系统资源叉 / Vite 构建缓存 ----------
**/__MACOSX/
**/.vite/

# ---------- 15. 本机参考素材与外部克隆（不入库）----------
# 四者合计约 900MB，均为本机对照/调试用，不是本仓库的源码：
#   asr/            独立 ASR 工程，自带 .git，且含 cert.pem 私钥与 *.vrm（红线）
#   vrm-playground/ 第三方 three-vrm 示例库克隆，自带 .git 与 node_modules
#   mp3素材/         戏曲/歌曲 mp3 试听素材（含一层重复嵌套目录），受版权保护
#   sherpa-onnx/     onnx 声纹/唤醒词模型与 wasm 产物（同 frontend/public/kws/ 口径）
# 入库会撞 GitHub 单文件 100MB 限制，且嵌套 .git 会被存成 gitlink 空壳。
# 需要共享时走网盘或 Git LFS，不随普通提交进入主仓。
vrm-playground/
asr/
mp3素材/
sherpa-onnx/

# laya 镜像离线 torch wheels（宿主预下载，体积大不进 git）
deploy/laya/wheels/

# 外部审计/评估材料（主理人裁决 2026-11-13：永不入库）
docs/audits/
