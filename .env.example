# ============================================================================
# 康伴（SilverMate）环境变量样例
# ----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env     然后只在 .env 里填真实值
# 铁律：
#   1. .env 已在 .gitignore，永不入库；本文件只放占位符，任何真实 key 都不许写进来
#   2. 代码里禁止 os.environ.get 散读，统一走 app/core 的 Pydantic Settings
#   3. 密钥不得写进 prompt、测试夹具、日志、提交信息
#   4. 变量名与端口为本项目自定义口径（PRD/技术文档/大纲均未定义），新增请同步 README §6
# ============================================================================

# ---------------------------- 应用 ----------------------------
APP_NAME=silvermate
APP_ENV=local                      # local | staging | prod
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=https://localhost  # 对外访问根地址，用于生成媒体与回调 URL
FRONTEND_ORIGIN=https://localhost:5173   # CORS 白名单，多个用英文逗号分隔
LOG_LEVEL=INFO

# ---------------------------- 鉴权 / JWT ----------------------------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-random-48-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120    # 工作人员/家属 Access Token 2h
REFRESH_TOKEN_EXPIRE_DAYS=7        # Refresh Token 7d
ELDER_SESSION_EXPIRE_HOURS=24      # 模拟设备凭证换取的会话 24h，解绑即失效

# ---------------------------- 数据库（业务表） ----------------------------
# docker compose 宿主端口映射（默认 5432/6379，与 README §6 端口约定一致）；
# 仅当本机这两个端口被其他项目占用时才改，改完 DATABASE_URL / REDIS_URL 的端口要跟着改
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql+asyncpg://silvermate:silvermate@localhost:5432/silvermate
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20
# pytest 专用测试库（阶段 C 根治）：与开发库物理隔离，并行才不会互相踩数据。
# 留空时 tests/conftest.py 自动推导 <库名>_test（绝不回退到开发库本身）
DATABASE_URL_TEST=

# ---------------------------- LangGraph Checkpoint（独立 schema + 独立连接池） ----------------------------
# 与业务表同实例、不同 schema，物理隔离；不要复用业务连接池
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://silvermate:silvermate@localhost:5432/silvermate
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph
LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=5

# ---------------------------- 缓存 / 限流 ----------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=silvermate
RATE_LIMIT_PER_MINUTE=60

# ---------------------------- System Two · 大模型（DeepSeek / Qwen 兼容 API） ----------------------------
LLM_PROVIDER=deepseek              # deepseek | qwen | other（OpenAI 兼容端点）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.6

# ---------------------------- System One · Laya 本地 sidecar（Day 7：LAYA_* → SYSTEM_ONE_*） ----------------------------
SYSTEM_ONE_ENABLED=true
SYSTEM_ONE_PROVIDER=laya             # laya | mock（生产禁 mock，启动即校验）
SYSTEM_ONE_BASE_URL=http://127.0.0.1:7001
SYSTEM_ONE_API_KEY=                  # 空 → 请求不带 Authorization
SYSTEM_ONE_TIMEOUT_MS=200            # 快路径预算 ≤200ms（PRD §5.3，不许为跑通调大）
SYSTEM_ONE_CONFIDENCE_THRESHOLD=0.85 # ≥0.85 直接路由，<0.85 只澄清一次
SYSTEM_ONE_FALLBACK_TO_AGENT=true    # 失败/低置信下沉 Agent
SYSTEM_ONE_MODEL_PATH=               # 权重目录（空 → /health 503 model_missing）
SYSTEM_ONE_MODEL_ID=laya-multilingual
SYSTEM_ONE_MODEL_VERSION=laya:multilingual:q1
SYSTEM_ONE_DEVICE=cpu
SYSTEM_ONE_MAX_CONCURRENCY=1         # CPU 推理并发 1，避免与 ASR/TTS 抢核
SYSTEM_ONE_WARMUP=true

# ---------------------------- 语音识别 ASR（第三方流式，教师统一提供 key） ----------------------------
ASR_PROVIDER=
ASR_BASE_URL=
ASR_APP_ID=
ASR_API_KEY=
ASR_LANGUAGE=zh-CN
ASR_TIMEOUT_MS=300                 # 首包预算
ASR_EMIT_CONFIDENCE=true           # 置信度埋点开关，评测归因依赖它
ASR_INSECURE=false                 # FunASR 镜像自带自签证书；本地连 wss://<funasr>:10095 时置 true，生产换真证书后必须关
ASR_HOTWORDS=                      # FunASR 热词，"词 权重" 空格分隔（例：小伴 20 小满 20 越剧 20）；空 = 不发热词，行为不变

# ---------------------------- 语音合成 TTS（第三方流式） ----------------------------
TTS_PROVIDER=
TTS_BASE_URL=
TTS_APP_ID=
TTS_API_KEY=
TTS_VOICE_ID=
TTS_SPEED=1.0
TTS_TIMEOUT_MS=300                 # 首包预算；首包延迟是链路最大风险点
TTS_FFMPEG_BIN=ffmpeg              # edge 兜底链路用；装好 ffmpeg 后默认走 PATH

# ---------------------------- WebRTC / TURN ----------------------------
STUN_URL=stun:localhost:3478
TURN_URL=turn:localhost:3478
TURN_USERNAME=silvermate
TURN_CREDENTIAL=replace-with-turn-password
TURN_CREDENTIAL_TTL_SECONDS=3600
WEBRTC_ICE_TIMEOUT_SECONDS=5       # 超时即降级为按住说话
WEBRTC_AUDIO_BITRATE_KBPS=32
WEBRTC_VAD_AGGRESSIVENESS=2        # webrtcvad 0-3

# ---------------------------- 天气（全系统唯一真实外部接口） ----------------------------
WEATHER_API_PROVIDER=amap           # 上游供应商标识（高德，2026-11-10 落实）
WEATHER_API_BASE_URL=https://restapi.amap.com  # 高德 REST 根地址（fetch 内拼 /v3/geocode/geo 与 /v3/weather/weatherInfo）
WEATHER_API_KEY=                    # 高德「Web服务」Key 占位符：https://lbs.amap.com → 应用管理 → 创建应用 → 添加 Key
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_DEFAULT_CITY=

# ---------------------------- 通知（仅 inapp / webpush，无微信、无邮件） ----------------------------
NOTIFY_CHANNEL=inapp               # inapp | webpush
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:admin@example.com
NOTIFY_RETRY_INTERVAL_SECONDS=30
NOTIFY_MAX_RETRIES=3

# ---------------------------- MCP 客户端 ----------------------------
MCP_WEATHER_SERVER_URL=http://localhost:7101
MCP_OPERATIONS_SERVER_URL=http://localhost:7102
MCP_CALL_TIMEOUT_SECONDS=5
MCP_ENABLE_AUDIT=true              # 越权调用必须落 audit_logs

# ---------------------------- 观测（Langfuse + OpenTelemetry + /metrics） ----------------------------
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SAMPLE_RATE=1.0
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=silvermate-backend
METRICS_ENABLED=true

# ---------------------------- 数据保留 / 调度 ----------------------------
AUDIO_RETENTION_HOURS=72           # 原始音频最长保留 72 小时，定时任务清理
AUDIO_DEBUG_SAVE=false             # 调试临时保存，禁止在生产打开
SCHEDULER_TIMEZONE=Asia/Shanghai
HEALTH_CHECKUP_START=19:00         # 健康采集窗口起点
HEALTH_CHECKUP_END=20:00           # 到点强制结束

# ---------------------------- 业务阈值（改动需评审，见 AGENTS.md §7） ----------------------------
MAX_TOOL_CALLS_PER_TURN=8
TOOL_REPEAT_WINDOW_SECONDS=60
TOOL_REPEAT_BREAK_THRESHOLD=3
MEDICATION_REMINDER_ATTEMPTS=4     # T0 / +5 / +10 / +15
MEDICATION_ATTEMPT_WAIT_SECONDS=60
VOICEPRINT_SIMILARITY_THRESHOLD=0.85
# VOICEPRINT_FERNET_KEY=           # embedding 加密落库，32 字节 url-safe base64；不配（或注释）则用代码内本地开发默认 key，生产必须注入

# ---------------------------- 前端（Vite 构建期注入，仅 VITE_ 前缀会暴露给浏览器） ----------------------------
VITE_API_BASE_URL=https://localhost/api
VITE_WS_BASE_URL=wss://localhost/ws
VITE_ENABLE_3D=true
VITE_ENABLE_WEBRTC=true
VITE_MEDIA_BASE_URL=https://localhost/media

# ---------------------------- 3D 数字人资产（Day 4 · A3） ----------------------------
# 相对路径（/avatars/xxx.vrm）或绝对 URL；留空则走下一层兜底（前端内置资源）
DEFAULT_AVATAR_URL=
DEFAULT_FALLBACK_AVATAR_URL=
# 仅 VRM0 需要 π 补偿；VRM1 保持 0.0
AVATAR_ROTATION_Y_OFFSET=0.0
# 想让前端强制刷新形象缓存时改这个值（响应里的 version 由它参与计算）
AVATAR_CACHE_VERSION_SALT=