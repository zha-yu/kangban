  <diagram id="day06-comm-flow" name="① 通信全链路（Day 6 实装）">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="康伴 Day 6 · 通信全链路（2026-11-09 实装）　｜　WS 控制面 + WebRTC 媒体面 + REST 降级面　｜　依据 day06/contracts.md v1.4" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1920" height="48" as="geometry"/></mxCell>
        <mxCell id="z1" value="① PAD 前端（frontend/src/pad/，1920×1080 大字）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FE;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="1920" height="190" as="geometry"/></mxCell>
        <mxCell id="z2" value="② 信令控制面　WS /ws/signal（app/audio/signaling.py，文本帧 JSON，一帧一对象）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3FAF2;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="1920" height="190" as="geometry"/></mxCell>
        <mxCell id="z3" value="③ 媒体面　WebRTC / aiortc（app/audio/webrtc.py，音频轨全双工）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9F5FB;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="1920" height="190" as="geometry"/></mxCell>
        <mxCell id="z4" value="④ 装配层与业务编排（app/main.py lifespan → services / agents / graphs）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8EF;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="40" y="692" width="1920" height="280" as="geometry"/></mxCell>
        <mxCell id="z5" value="⑤ 事实与外部（PG 事件账本 / Redis 状态中心 / MCP / REST 降级）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="40" y="984" width="1920" height="190" as="geometry"/></mxCell>

        <mxCell id="p1" value="E4 换证 + KWS「小伴」&lt;br&gt;POST /api/device-sessions&lt;br&gt;token 存 sessionStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="128" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="p2" value="SignalSocket（WS 客户端）&lt;br&gt;connecting→authing→ready&lt;br&gt;20s ping / 45s 判死 / 退避重连" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="128" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="p3" value="RTCPeerConnection + MicCapture&lt;br&gt;48k→16k/16bit/mono 20ms&lt;br&gt;600ms preRoll 环形缓冲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="128" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="p4" value="TEN-VAD 端侧（Worker 隔离）&lt;br&gt;speech_start / speech_end&lt;br&gt;0.5 / 0.8s / 0.25s / 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="128" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="p5" value="本地打断收口&lt;br&gt;muted/pause + 清字幕 + asr_start&lt;br&gt;flushPreRollToTrack 600ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="128" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="p6" value="PlaybackQueue（N16）&lt;br&gt;段 N 到 ⇒ 段 N-1 报 played&lt;br&gt;ack 尽力而为 + 500ms×1 重发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="128" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="p7" value="HoldToTalk（C3 降级）&lt;br&gt;assembleWav 44B 头&lt;br&gt;standby 相才渲染，不白屏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="128" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="p8" value="client_diag 上报&lt;br&gt;vrm_load/webrtc/vad/asr/playback&lt;br&gt;服务端代打 metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1740" y="128" width="210" height="66" as="geometry"/></mxCell>

        <mxCell id="w1" value="auth（≤300ms 首帧）→ auth_ok&lt;br&gt;auth_fail 4401 / 重复 auth 关闭&lt;br&gt;同设备踢旧留新 4002" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="w2" value="offer / answer / ice 双向&lt;br&gt;offer 前 candidate 缓存后 flush&lt;br&gt;loopback 排除 STUN/TURN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="w3" value="asr_start / asr_end（VAD 边界）&lt;br&gt;asr_partial / asr_final 字幕&lt;br&gt;只有 FINAL 触发业务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="330" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="w4" value="identity_ask（30s）→ identity_confirm&lt;br&gt;identity_result voice/confirm/generic&lt;br&gt;首轮强制校验（闸门①）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="330" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="w5" value="C5 身份确认与 generic 降级&lt;br&gt;generic 不加载个人记忆&lt;br&gt;拒绝用药/健康动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="330" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="w6" value="tts_text v2 分段下行&lt;br&gt;+response_id/epoch/segment_id/index/total&lt;br&gt;老字段不变，全部可选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="330" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="w7" value="segment_ack 上行（形状校验）&lt;br&gt;status: playing/played/canceled&lt;br&gt;at_ms 必填，epoch 原样回传" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="w8" value="error 下行（失败终态 + 话术）&lt;br&gt;asr_slow/llm_slow/tts_slow&lt;br&gt;未知消息不关连接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1740" y="330" width="210" height="66" as="geometry"/></mxCell>

        <mxCell id="m1" value="AudioNormalizer&lt;br&gt;16k / 16bit / mono 20ms 规范帧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="532" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="m2" value="DualFrameSplitter + PreRollBuffer&lt;br&gt;60ms ASR 帧 / 30ms VAD 帧&lt;br&gt;600ms 句首回放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="532" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="m3" value="ASRProvider.stream()&lt;br&gt;mock | funasr(2pass,wss:7002) | cloud&lt;br&gt;PARTIAL 字幕 / FINAL 业务 / ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="532" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="m4" value="dispatch_asr_event()&lt;br&gt;FINAL 才 await 编排&lt;br&gt;★ asyncio.shield 解耦旧连接取消" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="532" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="m5" value="barge_in()&lt;br&gt;playback_generation+1 / 清队列&lt;br&gt;旧 turn PCM 拒入队 + 1.5s echo 抑制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="532" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="m6" value="TTS PCM → 48k 帧写播放轨&lt;br&gt;enqueue_tts_for_device()&lt;br&gt;PlaybackAudioTrack.recv() 空队列补静音" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="532" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="m7" value="webrtcvad 服务端兜底&lt;br&gt;client_diag(vad,false) 唯一激活&lt;br&gt;3 帧起说 / 27 帧静音收尾" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="532" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="m8" value="TTSProvider&lt;br&gt;mock | edge-tts+ffmpeg | cloud 骨架&lt;br&gt;整段 16k PCM（非流式）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1740" y="532" width="210" height="66" as="geometry"/></mxCell>

        <mxCell id="a1" value="app/main.py lifespan 装配&lt;br&gt;ROUTERS + signaling.router + install_signaling_handler&lt;br&gt;同一 ResponseService 实例给七步与 ack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="734" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="a2" value="DialogueOrchestrator&lt;br&gt;L0 safety 一票否决（N27）&lt;br&gt;命中不进 Agent 不调 LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="734" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="a3" value="★ TurnService.handle_user_turn&lt;br&gt;七步：begin_turn→snapshot/apply→build→agent.run&lt;br&gt;→commit_response→apply→response_stream.start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="734" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="a4" value="CompanionAgent（ReAct）&lt;br&gt;Guardrails 8 次/轮 · 60s · 第 3 次熔断&lt;br&gt;九层上下文 + 记忆召回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="734" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="a5" value="ToolExecutor + MCPClient&lt;br&gt;白名单 / 幂等键 / 四类失败 / 身份闸门③&lt;br&gt;每次调用必写 audit_logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="734" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="a6" value="★ ResponseService.start()（第 7 步）&lt;br&gt;epoch+1 / 切段≤40 字 / 逐段下发&lt;br&gt;delivered_text=None 只记录生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="734" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="a7" value="★ ResponseService.ack() / interrupt()&lt;br&gt;四步校验 · 只有 played 推进水位&lt;br&gt;打断五步，事实只追加不回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="734" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="a8" value="weather MCP server :7101&lt;br&gt;get_weather(city) + 600s 缓存&lt;br&gt;无 key / 超时 ⇒ 查不到，不编造" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1740" y="734" width="210" height="70" as="geometry"/></mxCell>

        <mxCell id="b1" value="APScheduler 用药到点&lt;br&gt;19:00 健康采集 / 漏采派单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="852" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="b2" value="medication_confirmation_graph（N10）&lt;br&gt;remind→wait_confirm[interrupt]→taken/refused/retry≤3&lt;br&gt;先查后发防图重放重复投递" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="852" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="b3" value="_deliver_reminder（E2）&lt;br&gt;WS 先投字幕；speak_fn 尽力写 WebRTC&lt;br&gt;不带 response_id/epoch/segment；回执只认文本入队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="852" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="b4" value="signaling.deliver(device_id, msg)&lt;br&gt;按 device_id 找在线连接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="852" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="b5" value="触达回执三态&lt;br&gt;voice_dispatched / device_offline&lt;br&gt;/ no_bound_device（0012）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="852" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="b6" value="漏服升级工单&lt;br&gt;work_order_service.open_missed_medication&lt;br&gt;确定性单号 + SAVEPOINT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="852" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="b7" value="N27 安全命中&lt;br&gt;risk_events + work_orders + notifications&lt;br&gt;三行同事务（0011）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="852" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="b8" value="回复 PCM 由 main.py 整段合成写 WebRTC&lt;br&gt;NullTtsQueue 仅为 ResponseService 停播桩&lt;br&gt;E2 speak_fn 失败仍保留字幕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1740" y="852" width="210" height="70" as="geometry"/></mxCell>

        <mxCell id="d1" value="history_service（N04）&lt;br&gt;SELECT last_event_seq FOR UPDATE&lt;br&gt;只追加 + ref_event_id，禁 UPDATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#7A7A7A;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1026" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="d2" value="conversation_events / turns&lt;br&gt;/ tool_executions（0008）&lt;br&gt;12 类事件 · UNIQUE(thread_id,seq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#7A7A7A;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1026" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="d3" value="StateCenter（N05，Redis）&lt;br&gt;session:{thread_id}:state TTL 2h&lt;br&gt;Lua CAS + Coordinator 每 thread 锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#7A7A7A;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="1026" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="d4" value="memory_chunks（0009）&lt;br&gt;vector(1536) · 闸门② elder_id&lt;br&gt;召回失败本轮不加载，不臆造" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#7A7A7A;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="1026" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="d5" value="PostgreSQL 业务表&lt;br&gt;0008–0012 五批迁移&lt;br&gt;业务表与 langgraph schema 物理隔离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#7A7A7A;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="1026" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="d6" value="PG Checkpointer&lt;br&gt;独立 langgraph schema + 连接池&lt;br&gt;重启可恢复，不重发已完成触达" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#7A7A7A;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="1026" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="d7" value="audit_logs / metrics / notifications&lt;br&gt;每次工具调用与分段打点&lt;br&gt;全链 trace_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#7A7A7A;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="1026" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="d8" value="POST /api/audio/utterance（C3）&lt;br&gt;16k WAV ≤30s · 422/413/503&lt;br&gt;模板话术 + /static/mock/*.wav" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1740" y="1026" width="210" height="70" as="geometry"/></mxCell>

        <mxCell id="l1" value="图例与阅读顺序&lt;br&gt;■ 蓝=主链路实线　■ 橙虚线=送达回执（segment_ack）　■ 红虚线=降级/兜底　■ 黄虚线=主动触达 E2　■ 灰虚线=写事实/存储&lt;br&gt;① E4 换证 → WS auth(300ms) → SDP/ICE → WebRTC 音频轨 → 端侧 VAD 切段 → ASR FINAL（shield）→ L0 安全否决 → 统一出口七步 → 工具/MCP → 分段 tts_text v2 → pad 播放 → segment_ack 四步校验 → 事件账本&lt;br&gt;② 打断：speech_start ⇒ 本地停播 + asr_start ⇒ barge_in() ⇒ epoch+1 ⇒ 五步收口；delivered_text 只拼 played 段，generated_text 与 delivered_text 允许不相等&lt;br&gt;③ 三级降级：TEN-VAD →（client_diag vad:false）webrtcvad →（WebRTC 不可用）按住说话 REST 整段上传；明确配置 funasr/edge 才走本地兜底；Provider 留空时为 mock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="1186" width="1920" height="150" as="geometry"/></mxCell>

        <mxCell id="e1" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3D6FB4;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
