        <mxCell id="1" parent="0"/>
        <mxCell id="ct1" value="康伴 Day 6 · 核心逻辑与必要配置（可核查口径）　｜　契约：docs/team_tasks/day06/contracts.md v1.4" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1920" height="48" as="geometry"/></mxCell>
        <mxCell id="cz1" value="A · 统一出口七步（app/services/turn_service.py:619-790，顺序即契约，不得改动）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8EF;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="1920" height="230" as="geometry"/></mxCell>
        <mxCell id="cz2" value="B · 送达回执四步校验 + 水位截断（app/services/response_service.py:382-480）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FE;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="940" height="290" as="geometry"/></mxCell>
        <mxCell id="cz3" value="C · 打断五步与事件账本（response_service.py:484-535 / history_service.py）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F9F5FB;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="960" height="290" as="geometry"/></mxCell>
        <mxCell id="cz4" value="D · 配置速查（环境变量 = Settings 字段全大写，app/core/config.py）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="40" y="634" width="1180" height="400" as="geometry"/></mxCell>
        <mxCell id="cz5" value="E · 契约常量 / 消息全集 / 验收（day06/contracts.md、PROGRESS、a1 延迟基线表）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3FAF2;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1240" y="634" width="720" height="400" as="geometry"/></mxCell>

        <mxCell id="c1" value="1 begin_turn&lt;br&gt;事实先落（含 turn_started）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="c2" value="2 snapshot / apply&lt;br&gt;显式 CAS，版本冲突上抛" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="c3" value="3 build&lt;br&gt;九层上下文 + 记忆召回（闸门②）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="140" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="c4" value="4 agent.run&lt;br&gt;ReAct + 工具事件缓冲回灌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="140" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="c5" value="5 commit_response&lt;br&gt;★ delivered_text=None&lt;br&gt;同一枚 response_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="140" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="c6" value="6 state.apply&lt;br&gt;以第 2 步返回版本原样再 CAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="140" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="c7" value="7 response_stream.start&lt;br&gt;最后下发，全链成功才 commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="140" width="230" height="66" as="geometry"/></mxCell>
        <mxCell id="c8" value="为什么顺序不能换：① 事实先落，模型看不到还没发生的事；② 第 5 步只记「生成」，第 7 步之后才知道「送达」，二者分离才能正确表达打断截断；③ 第 5/7 步共用 response_id 才能与 ack 对账；④ 事务罩住全链，except BaseException → rollback，不留「已下发但无事实」的孤儿回复。⑤ generic（无 elder_id）不建 ConversationTurn 投影，改直写 response_completed 事件。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="222" width="1880" height="80" as="geometry"/></mxCell>

        <mxCell id="c9" value="① response_id 存在且 device_id 相同&lt;br&gt;否则 unknown_response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="384" width="200" height="66" as="geometry"/></mxCell>
        <mxCell id="c10" value="② epoch == 当前会话 epoch&lt;br&gt;跨代淘汰 → stale_epoch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="384" width="200" height="66" as="geometry"/></mxCell>
        <mxCell id="c11" value="③ status == playing&lt;br&gt;同代内打断后追认拦截 → wrong_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="384" width="200" height="66" as="geometry"/></mxCell>
        <mxCell id="c12" value="④ 0 ≤ segment_id ≤ total-1 且严格大于水位&lt;br&gt;严格单调 → not_monotonic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1A1A1A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="705" y="384" width="255" height="66" as="geometry"/></mxCell>
        <mxCell id="c13" value="★ canceled 只走 ①②③，跳过 ④；segment_id 回显水位，一段未播完填 -1（与服务端初值同构）。&lt;br&gt;★ 只有 played 推进 last_acked_segment；playing 只打 response_segment 指标。若让 playing 推进，同段 played 会被 ④ 判迟到，delivered_text 恒为 None；改成 ≥ 又会把播到一半的段算成「听过」。&lt;br&gt;★ delivered_text = 按 index 升序拼 segments[0..水位]；末段 played 才触发 response_completed；delivery_status 只取 delivered/interrupted/unknown，永不写 understood。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="466" width="900" height="140" as="geometry"/></mxCell>
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3D6FB4;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3D6FB4;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3D6FB4;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="c14" value="打断五步（顺序不可交换）：① 收到 → ② _tts_queue.stop(response_id) → ③ epoch += 1 → ④ 逐个 cancellable.cancel() → ⑤ 追加 response_interrupted 事件 + delivery_status=interrupted。&lt;br&gt;幂等：response 不存在或已结束即 no-op，不重复 bump epoch。工具副作用不随回复取消，已写事件与 played 事实一律保留。&lt;br&gt;&lt;br&gt;事件账本：SELECT last_event_seq … FOR UPDATE → +1 → 写回 → 插事件（禁止「先查 max 再 +1」）；更正写新事件带 ref_event_id，禁止 UPDATE 旧行；conversation_turns.status 终态只由 finish_turn 写（单写口）。&lt;br&gt;&lt;br&gt;状态中心：Redis session:{thread_id}:state TTL 2h；apply(expected_version, events) Lua CAS；冲突抛 StateVersionConflict 不覆盖；Coordinator 每 thread 一把 asyncio.Lock，冲突自动重试 ≤3。适配器显式调 StateCenter.apply 而不走 submit（submit 会静默重试吞掉并发写入）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1020" y="384" width="920" height="222" as="geometry"/></mxCell>

        <mxCell id="c15" value="【WS 硬常量】auth 300ms · ping 20s · 45s 无帧判死 · identity_ask 30s · 关闭码 4401 鉴权失败 / 4002 同设备踢旧留新 · 设备会话无 refresh 通道&lt;br&gt;【音频规范】16k/16bit/mono · 20ms 规范帧 · 60ms ASR 帧 · 30ms VAD 帧 · preRoll 600ms · 下行 48k · ASR 队列 500 帧(30s) · 播放队列 750 帧(15s)&lt;br&gt;【VAD】端侧 TEN-VAD threshold 0.5 / 静音 0.8s / minSpeech 0.25s / maxSpeech 30s / Worker 加载 30s 超时；服务端 webrtcvad aggressiveness 3 / 起说 3 帧(90ms) / 收尾 27 帧(810ms) / ECHO_COOLDOWN 1.5s&lt;br&gt;【分段】服务端切：。！？；优先，单段 ≤40 字，长句按逗号补切；拼接恒等于原文；ack 重发 500ms × 1；水位初值 -1&lt;br&gt;【预算】max_tool_calls_per_turn=8 · tool_repeat_window_seconds=60 · tool_repeat_break_threshold=3 · mcp_call_timeout_seconds=5 · weather_cache_ttl_seconds=600&lt;br&gt;【慢响应】degrade_asr_slow_ms=2000 · degrade_llm_slow_ms=3000 · degrade_tts_slow_ms=1000（watchdog 先发话术，首包到达取消）&lt;br&gt;【Provider】ASR_PROVIDER / TTS_PROVIDER：mock（空或未知默认）| funasr（wss://localhost:7002，2pass，chunk_size=[5,10,5]，itn=true，共享容器 :10096 + FUNASR_INSECURE=1）| edge（zh-CN-XiaoxiaoNeural + TTS_FFMPEG_BIN=ffmpeg，16k/16bit/mono PCM）| cloud 骨架&lt;br&gt;【LLM / 其他】llm_provider=deepseek，llm_base_url=https://api.deepseek.com/v1，llm_timeout_seconds=20，llm_max_retries=2；voiceprint_similarity_threshold=0.55；audio_retention_hours=72；elder_session_expire_hours=24；rate_limit_per_minute=60&lt;br&gt;【ICE】stun_url=stun:localhost:3478 · turn_url=turn:localhost:3478 · turn_username=silvermate · turn_credential_ttl_seconds=3600 · webrtc_ice_timeout_seconds=5 · webrtc_audio_bitrate_kbps=32 · webrtc_vad_aggressiveness=3（loopback 自动排除）&lt;br&gt;【端口】postgres 5432 · redis 6379 · backend 8000 · nginx 80/443 · laya 7001 · FunASR 7002 · 声纹 7003 · weather-mcp 7101 · mock-ops 7102 · coturn 3478/5349 · vite 5173&lt;br&gt;【迁移】0008 事件三表 · 0009 memory_chunks 23 列 + vector(1536) · 0010 用药六表 · 0011 notifications · 0012 receipt CHECK 六值白名单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="60" y="688" width="1140" height="332" as="geometry"/></mxCell>

        <mxCell id="c16" value="【五个标识（全部服务端生成，客户端不可指定）】thread_id 会话 / call_id 建连 / turn_id 一轮（幂等键）/ response_id 一次回复 / task_id 跨轮任务&lt;br&gt;&lt;br&gt;【WS 上行 9 类】auth · offer · ice · ping · asr_start · asr_end · identity_confirm · client_diag · segment_ack&lt;br&gt;【WS 下行 11 类】auth_ok · auth_fail · answer · ice · pong · asr_partial · asr_final · tts_text · error · identity_ask · identity_result&lt;br&gt;&lt;br&gt;【tts_text v2】老字段 type/text/degraded 不变；新增 response_id/epoch/segment_id/index/total 全部可选；epoch 客户端原样回传不得自增；E2 主动触达不带这五个字段（整段一播，无需 ack）&lt;br&gt;【segment_ack】status ∈ playing/played/canceled；at_ms 必填（客户端单调时钟，只折算时长不参与判定）；rejected_reason 四枚举：unknown_response / stale_epoch / wrong_status / not_monotonic&lt;br&gt;&lt;br&gt;【12 类事件】turn_started · asr_final_committed · response_started · response_segment_delivered · response_interrupted · response_completed · tool_started · tool_succeeded · tool_failed · task_waiting · task_resumed · turn_completed&lt;br&gt;&lt;br&gt;【验收】975 passed / 4 skipped / 1 deselected，覆盖率 81.51%，ruff 干净；A 线 21.0/21.0，并发 20 写 seq=1..20，50 例普通语料安全误报 0；E20 三层测试全绿&lt;br&gt;【AC-42】0/16 不达标；e2e P50 7872ms / P95 13537ms；识别后响应 P50 2920ms / P95 5873ms；归因三段非流式（FunASR 4909ms 含说话 + LLM 1470ms + edge-tts 1477ms）&lt;br&gt;【看板】PROGRESS.md 显示 2/7 是任务卡状态行未回填的机械滞后；当日 44 个非 merge 提交 + 27 个 merge（PR #42–#55）&lt;br&gt;【边界】回复音频由 main.py 整段合成后写 WebRTC；NullTtsQueue 仅为停播桩 · 当前工作区补 E2 speak_for_device 尽力写已有 WebRTC（voice_dispatched 只指文本入队）· E2 played 闭环、反向 WebRTC 外呼/自动接听未落地 · WD-1/WD-2 工单建单口 · M-1~M-4 记忆治理顺延 Day 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1260" y="688" width="680" height="332" as="geometry"/></mxCell>
        <mxCell id="cl2" value="阅读顺序：A 七步 → B 四步校验 → C 打断/账本 → D 配置 → E 契约与验收。所有数值均可在 app/core/config.py、app/audio/signaling.py、app/audio/webrtc.py、app/services/response_service.py 中核对；改字段必须先升契约版本号再改代码（AGENTS.md §10.4）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8D2E0;fontColor=#1A1A1A;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="1048" width="1920" height="80" as="geometry"/></mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D79B00;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
